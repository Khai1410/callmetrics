# Copy this file to .env and adjust if needed (optional — the app runs with
# sensible defaults even without a .env file at all).

# Port on your machine to open the app at (http://localhost:PORT).
# Change this only if 8081 is already used by something else.
FRONTEND_PORT=8081

# Speech-to-text model size. Bigger = more accurate but slower and needs
# more RAM/CPU. Options: tiny, base, small, medium, large-v3.
WHISPER_MODEL_SIZE=small
