# Copy this file to .env and adjust if needed (optional — the app runs with
# sensible defaults even without a .env file at all).

# Port on your machine to open the app at (http://localhost:PORT).
# Change this only if 8081 is already used by something else.
FRONTEND_PORT=8081

# Speech-to-text model size. Bigger = more accurate but slower and needs
# more RAM/CPU. Options: tiny, base, small, medium, large-v3. "large-v3" is
# noticeably more accurate for Vietnamese if "medium" still isn't good enough
# and your machine can handle a slower first run per call.
WHISPER_MODEL_SIZE=medium

# Optional: add company-specific vocabulary (product names, brand names,
# common phrases) to bias the speech-to-text spelling. Leave blank to use
# the built-in Vietnamese customer-service default.
WHISPER_INITIAL_PROMPT=

# Required for the app to auto-score calls with AI. Get a key at
# https://console.anthropic.com/settings/keys — this is billed to your own
# Anthropic account per call scored (transcript text only, not audio).
# Leave blank to fall back to keyword-only scoring (no AI, no cost).
ANTHROPIC_API_KEY=

# Which Claude model to use for scoring. Leave as-is unless told otherwise.
ANTHROPIC_MODEL=claude-opus-5
